 smali_classes2/Td/c.smali | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/smali_classes2/Td/c.smali b/smali_classes2/Td/c.smali
index 0eb1806..99b03e0 100644
--- a/smali_classes2/Td/c.smali
+++ b/smali_classes2/Td/c.smali
@@ -233,7 +233,7 @@
 
     invoke-virtual {v0, v3}, Ljava/lang/String;->contains(Ljava/lang/CharSequence;)Z
 
-    move-result v0
+    const/4 v0, 0x1
 
     sput-boolean v0, LTd/c;->m:Z
 
